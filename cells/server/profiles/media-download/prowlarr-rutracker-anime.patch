+    {
+        [TestCase("Технолайз / Texhnolyze [TV] [22 из 22] [RUS(ext), JAP] [2003, BDRip]", "Texhnolyze [TV] S1E1-22 of 22 [RUS(ext), JAP] [2003, BDRip]")]
