              "__name__": true,
              "instance": true,
              "job": true,
              "host": true,
              "attribute_flags_long": true,
              "attribute_flags_short": true,
              "attribute_id": true,
              "attribute_name": true,
              "attribute_value_type": true
            },
            "renameByName": {
              "Value #A": "reallocated",
              "Value #B": "Δ 24 h"
            },
            "indexByName": {
              "device": 0,
              "reallocated": 1,
              "Δ 24 h": 2
            }
          }
        }
