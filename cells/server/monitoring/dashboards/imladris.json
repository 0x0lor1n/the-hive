    {
      "id": 2,
      "type": "timeseries",
      "title": "HDD temperature (SMART)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "smartctl_device_temperature{host=\"imladris\",temperature_type=\"current\",device=~\"sd.*\"} * on (host, device) group_left (model_name, serial_number) smartctl_device{host=\"imladris\"}",
          "legendFormat": "{{device}} {{serial_number}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 55
              },
              {
                "color": "red",
                "value": 65
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "IronWolf/Barracuda operating max 65 °C.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
