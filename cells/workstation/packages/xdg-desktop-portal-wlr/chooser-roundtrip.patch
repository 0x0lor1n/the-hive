Re-read toplevels after the chooser returns: the chooser may map the window
it answers with (share-chooser's wl-mirror for rotated outputs), which the
snapshot taken before spawning it does not contain.

diff --git a/src/screencast/chooser.c b/src/screencast/chooser.c
index 7d66898..42cc106 100644
--- a/src/screencast/chooser.c
+++ b/src/screencast/chooser.c
@@ -174,6 +174,10 @@ static bool wlr_chooser(const struct xdpw_chooser *chooser,
 		return true;
 	}
 
+	// The chooser may have mapped the toplevel it answers with (a mirror
+	// window); pull in toplevels created while it ran.
+	wl_display_roundtrip(ctx->state->wl_display);
+
 	logprint(TRACE, "wlroots: chooser %s selects %s", chooser->cmd, selected_label);
 
 	bool found = false;
