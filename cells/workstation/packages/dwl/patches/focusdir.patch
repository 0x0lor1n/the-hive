+/* focusdir binds are left to the focused client when its app_id is in
+ * focusdir_passthrough[] (config.h): terminals that use the same chords. */
+static int
+focusdir_passthrough_focused(void)
+{
+	Client *c = focustop(selmon);
+	const char *const *id;
+	if (!c)
+		return 0;
+	for (id = focusdir_passthrough; id < END(focusdir_passthrough); id++)
+		if (!strcmp(client_get_appid(c), *id))
+			return 1;
+	return 0;
+}
+
 const Key *
 keybinding(uint32_t mods, xkb_keysym_t sym)
 {
@@ -1751,8 +1811,11 @@ keybinding(uint32_t mods, xkb_keysym_t sym)
 		return modekeybinding(mods, sym);
 
 	for (k = keys; k < END(keys); k++) {
-		if (CLEANMASK(mods) == CLEANMASK(k->mod) && sym == k->keysym && k->func)
+		if (CLEANMASK(mods) == CLEANMASK(k->mod) && sym == k->keysym && k->func) {
+			if (k->func == focusdir && focusdir_passthrough_focused())
+				return NULL;
 			return k;
+		}
 	}
 	return NULL;
 }
