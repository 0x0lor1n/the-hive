+void
+focusdir(const Arg *arg)
+{
+	/* Focus the nearest visible client in a direction, like tmux
+	 * select-pane: perpendicular overlap first, then edge gap, then
+	 * center offset. No wrap. */
+	Client *c, *sel = focustop(selmon), *best = NULL;
+	struct wlr_box *s, *b;
+	int gap, off, ovl, bgap = 0, boff = 0, bovl = 0;
+	if (!sel || (sel->isfullscreen && !client_has_children(sel)))
+		return;
+	s = &sel->geom;
+	wl_list_for_each(c, &clients, link) {
+		if (c == sel || !VISIBLEON(c, selmon))
+			continue;
+		b = &c->geom;
+		switch (arg->i) {
+		case WLR_DIRECTION_LEFT:  gap = s->x - (b->x + b->width); break;
+		case WLR_DIRECTION_RIGHT: gap = b->x - (s->x + s->width); break;
+		case WLR_DIRECTION_UP:    gap = s->y - (b->y + b->height); break;
+		default:                  gap = b->y - (s->y + s->height); break;
+		}
+		if (arg->i == WLR_DIRECTION_LEFT || arg->i == WLR_DIRECTION_RIGHT) {
+			ovl = b->y < s->y + s->height && s->y < b->y + b->height;
+			off = abs((b->y + b->height / 2) - (s->y + s->height / 2));
+		} else {
+			ovl = b->x < s->x + s->width && s->x < b->x + b->width;
+			off = abs((b->x + b->width / 2) - (s->x + s->width / 2));
+		}
+		/* borders overlap by a pixel or two between adjacent tiles */
+		if (gap < -(int)borderpx * 2)
+			continue;
+		if (!best || ovl > bovl || (ovl == bovl && (gap < bgap
+				|| (gap == bgap && off < boff)))) {
+			best = c;
+			bgap = gap;
+			boff = off;
+			bovl = ovl;
+		}
+	}
+	if (best)
+		focusclient(best, 1);
+}
+
 void
 focusstack(const Arg *arg)
 {
@@ -1737,6 +1782,21 @@ inputdevice(struct wl_listener *listener, void *data)
 	wlr_seat_set_capabilities(seat, caps);
