Resolve keybindings in the first xkb layout, so latin binds fire on the ru
group. v0.9 looks up level 0/1 of the active layout; pin that layout to 0.

diff --git a/dwl.c b/dwl.c
index bf671f9..fe18703 100644
--- a/dwl.c
+++ b/dwl.c
@@ -1746,7 +1746,9 @@ keypress(struct wl_listener *listener, void *data)
 	/* Translate libinput keycode -> xkbcommon */
 	uint32_t keycode = event->keycode + 8;
 	struct wlr_keyboard *kb = &group->wlr_group->keyboard;
-	xkb_layout_index_t layout = xkb_state_key_get_layout(kb->xkb_state, keycode);
+	/* Bindings are written as latin keysyms: resolve them in the first
+	 * configured layout, so they still fire while the ru group is active. */
+	xkb_layout_index_t layout = 0;
 	int handled = 0;
 
 	// Get the keysyms for level 0 (normal) and level 1 (shifted)
