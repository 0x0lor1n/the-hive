+void
+raiseorspawn(const Arg *arg)
+{
+	const Raise *r = arg->v;
+	Client *c;
+	wl_list_for_each(c, &fstack, flink) {
+		if (!c->mon || strcmp(client_get_appid(c), r->appid))
+			continue;
+		selmon = c->mon;
+		if (!VISIBLEON(c, selmon))
+			view(&(Arg){.ui = c->tags});
+		focusclient(c, 1);
+		return;
+	}
+	spawn(&(Arg){.v = r->cmd});
+}
