+/// Retries `f` on a spawn-time ENOENT: mitigates a benign TOCTOU race where
+/// exec on a just-written, just-chmod'd temp file intermittently fails
+/// (confirmed via strace on a live himmelblaud-tasks process).
+fn spawn_with_enoent_retry<F>(mut f: F) -> Result<std::process::Output>
+where
+    F: FnMut() -> Result<std::process::Output>,
+{
+    const MAX_ATTEMPTS: u32 = 5;
+    const RETRY_DELAY: Duration = Duration::from_millis(25);
+    let mut attempt = 0;
+    loop {
+        attempt += 1;
+        match f() {
+            Ok(out) => return Ok(out),
+            Err(e) => {
+                let is_enoent = e
+                    .downcast_ref::<io::Error>()
+                    .map(|io_err| io_err.kind() == io::ErrorKind::NotFound)
+                    .unwrap_or(false);
+                if is_enoent && attempt < MAX_ATTEMPTS {
+                    debug!(
+                        attempt,
+                        max_attempts = MAX_ATTEMPTS,
+                        "Discovery script spawn hit ENOENT on its own just-written temp file, retrying"
+                    );
+                    std::thread::sleep(RETRY_DELAY);
+                    continue;
+                }
+                return Err(e);
+            }
+        }
+    }
+}
