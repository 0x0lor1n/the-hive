@@ -1177,3 +1177,10 @@ mod tests {
         assert!(should_block_hello_pin_attempts(1, 0));
     }
 }
+
+/// PINDBG: first 4 bytes of sha256 as hex — enough to compare attempts, useless to recover the PIN.
+pub fn pindbg_sha8(s: &str) -> String {
+    use sha2::Digest;
+    let d = sha2::Sha256::digest(s.as_bytes());
+    d.iter().take(4).map(|b| format!("{:02x}", b)).collect()
+}
