{
  "name": "liquidsoap",
  "scopeName": "source.liquidsoap",
  "fileTypes": ["liq"],
  "patterns": [
    { "name": "comment.line.number-sign.liquidsoap", "match": "#.*$" },
    {
      "name": "string.quoted.double.liquidsoap",
      "begin": "\"", "end": "\"",
      "patterns": [{ "name": "constant.character.escape.liquidsoap", "match": "\\\\." }]
    },
    {
      "name": "string.quoted.single.liquidsoap",
      "begin": "'", "end": "'",
      "patterns": [{ "name": "constant.character.escape.liquidsoap", "match": "\\\\." }]
    },
    { "name": "keyword.control.liquidsoap",
      "match": "\\b(def|end|if|then|elsif|else|let|fun|begin|and|or|not|while|for|do|try|catch|rec|replaces|open)\\b" },
    { "name": "constant.language.liquidsoap", "match": "\\b(true|false|null)\\b" },
    { "name": "constant.numeric.liquidsoap", "match": "\\b\\d+(\\.\\d*)?\\b" },
    { "name": "support.function.liquidsoap", "match": "\\b[a-z_][A-Za-z0-9_]*(\\.[a-z_][A-Za-z0-9_]*)+(?=\\()" },
    { "name": "variable.parameter.liquidsoap", "match": "\\b[a-z_][A-Za-z0-9_]*(?==)" },
    { "name": "keyword.operator.liquidsoap", "match": "\\^|:=|==|!=|<=|>=|->" }
  ]
}
