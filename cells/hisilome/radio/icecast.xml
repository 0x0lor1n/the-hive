<icecast>
    <limits>
        <clients>100</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <!-- radio.liq's stream_latency must match. Under <queue-size>; never
             0 or the mp3 decoder has no header run-in. -->
        <burst-size>131072</burst-size>   <!-- 128 KiB = 8.192s at 128 kbps -->
    </limits>
    <!-- Dev values; safe only while <bind-address> is 127.0.0.1. Production
         renders real ones in (nixosModules/setup.nix). -->
    <authentication>
        <source-password>hackme</source-password>
        <relay-password>hackme</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>hackme</admin-password>
    </authentication>
    <hostname>127.0.0.1</hostname>
    <listen-socket>
        <port>8000</port>
        <bind-address>127.0.0.1</bind-address>
    </listen-socket>
    <mount type="normal">
        <mount-name>/stream.opus</mount-name>
        <burst-size>131072</burst-size>  <!-- 128 KiB = 8.192s at 128 kbps -->
    </mount>
    <paths>
        <basedir>./radio/state</basedir>
        <logdir>./radio/state/logs</logdir>
        <!-- Only icecast's own status pages, never proxied; production
             re-points these. -->
        <webroot>/nix/store/ywd949qjdi35ks685ala4vdh86w1vp1i-icecast-2.5.0/share/icecast/web</webroot>
        <adminroot>/nix/store/ywd949qjdi35ks685ala4vdh86w1vp1i-icecast-2.5.0/share/icecast/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>
    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
    </logging>
    <security>
        <chroot>0</chroot>
    </security>
</icecast>
