# Kanagawa "wave" classes, mirrored from static/style.css. Imported into every
# diagram (`...@classes`) so a palette change happens in one place.
#
# No canvas: the SVG is inlined, so the page background (--bg, #1f1f28) shows
# through. Boxes use --bg-dim (#16161d), the same as code blocks, and the
# "carrier"/"note" boxes keep it too - they differ by stroke, not fill.
style.fill: transparent

classes: {
  box: {
    style: {fill: "#16161d"; stroke: "#363646"; font-color: "#dcd7ba"; stroke-width: 1}
  }
  ours: {
    style: {fill: "#16161d"; stroke: "#98bb6c"; font-color: "#dcd7ba"; stroke-width: 2}
  }
  carrier: {
    style: {fill: "#16161d"; stroke: "#727169"; font-color: "#727169"; stroke-width: 1}
  }
  drawer: {
    style: {fill: "#16161d"; stroke: "#727169"; font-color: "#727169"; stroke-width: 1; stroke-dash: 3}
  }
  note: {
    style: {fill: "#16161d"; stroke: "#e6c384"; font-color: "#e6c384"; stroke-width: 1; stroke-dash: 2}
  }
  grp: {
    style: {fill: "#16161d"; stroke: "#363646"; font-color: "#727169"; stroke-width: 1}
  }
}
