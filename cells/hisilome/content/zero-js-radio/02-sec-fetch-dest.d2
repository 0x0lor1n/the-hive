...@classes

direction: down

nav: "GET /salt-fiber-bypass/\nSec-Fetch-Dest: document" {
  class: box
  label.near: top-center
  style.font-size: 16
  b: "" {shape: image; icon: icons/browser.svg; width: 48; height: 48}
}
frame: "GET /salt-fiber-bypass/\nSec-Fetch-Dest: iframe" {
  class: box
  label.near: top-center
  style.font-size: 16
  b: "" {shape: image; icon: icons/browser.svg; width: 48; height: 48}
}
curl: "GET /salt-fiber-bypass/\nno Sec-Fetch-Dest header" {
  class: carrier
  label.near: top-center
  style.font-color: "#dcd7ba"
  style.font-size: 16
  direction: right
  c: "" {shape: image; icon: icons/curl.svg; width: 48; height: 48}
  r: "" {shape: image; icon: icons/rss.svg; width: 48; height: 48}
  b: "" {shape: image; icon: icons/crawler.svg; width: 48; height: 48}
}

nginx: "" {
  class: ours
  style.font-size: 16
  ico: "" {shape: image; icon: icons/nginx.svg; width: 48; height: 48}
  map: "map \$http_sec_fetch_dest\$uri  \$shell_page\n~^document.*/\$  /listen/index.html\ndefault  /__none" {class: note}
}

shell: "/listen/index.html\nshell + <audio>\n<iframe src=<!--# echo var=request_uri -->>" {class: ours}
post: /salt-fiber-bypass/index.html\nbare post {class: box}

nav -> nginx.map {style.stroke: "#98bb6c"}
frame -> nginx.map {style.stroke: "#98bb6c"}
curl -> nginx.map {style.stroke: "#727169"}
nginx.map -> shell: "document " {style.stroke: "#98bb6c"}
nginx.map -> post: iframe / no header {style.stroke: "#98bb6c"}
shell -> frame: the frame requests\nthe same URL {style.stroke: "#e6c384"; style.stroke-dash: 3}
