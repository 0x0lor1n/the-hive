...@classes

direction: down

liq: "" {
  class: ours
  style.font-size: 16
  direction: right
  ico: "" {shape: image; icon: icons/liquidsoap.svg; width: 48; height: 48}
  np: now-playing.txt\nper track {class: box}
  con: console.txt\nevery second {class: box}
  sch: schedule.txt\nevery 10 s {class: box}
}

state: radio/state/\n(atomic renames) {class: drawer}

zola: "" {
  class: carrier
  shape: image
  icon: icons/zola.svg
  width: 48
  height: 48
}

nginx: "" {
  class: ours
  style.font-size: 16
  ico: "" {shape: image; icon: icons/nginx.svg; width: 48; height: 48}
  ssi: "ssi on;\n<!--# include virtual=... -->" {class: box}
}

browser: "" {
  class: box
  direction: down
  style.font-size: 16
  ico: "" {shape: image; icon: icons/browser.svg; width: 48; height: 48}
  shell: "shell page\n<audio> never reloads" {class: box}
}
frame: "<iframe> live.html\n<meta refresh 10>" {class: note}
browser.shell -> frame: embeds {style.stroke: "#727169"}

liq -> state: file.write.stream(atomic=true) {style.stroke: "#98bb6c"}
zola -> nginx: "zola build: templates\nwith SSI comments (at deploy)" {style.stroke: "#727169"}
state -> nginx.ssi: read on every request {style.stroke: "#98bb6c"}
nginx -> frame: "assembled HTML\nfragment, every 10 s" {style.stroke: "#98bb6c"}
nginx -> browser.shell: once {style.stroke: "#727169"}
