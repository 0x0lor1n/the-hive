# layout: dagre
...@classes

direction: down

liq: "" {
  class: ours
  style.font-size: 16
  grid-rows: 1
  grid-gap: 16
  ico: "" {class: ico; icon: icons/liquidsoap.svg; width: 72; height: 72}
  np: now-playing.txt\nper track {class: box; height: 72}
  con: console.txt\nevery second {class: box; height: 72}
  sch: schedule.txt\nevery 10 s {class: box; height: 72}
}

state: radio/state/\n(atomic renames) {class: drawer}

zola: "" {
  class: carrier
  shape: image
  icon: icons/zola.svg
  width: 48
  height: 48
}

nginx: "" {
  class: ours
  style.font-size: 16
  grid-rows: 1
  grid-gap: 16
  ico: "" {class: ico; icon: icons/nginx.svg; width: 72; height: 72}
  ssi: "ssi on;\n<!--# include virtual=... -->" {class: box; height: 72}
}

browser: "" {
  class: box
  style.font-size: 16
  grid-rows: 1
  grid-gap: 16
  ico: "" {class: ico; icon: icons/browser.svg; width: 72; height: 72}
  shell: "shell page\n<audio> never reloads" {class: box; height: 72}
}
frame: "<iframe> live.html\n<meta refresh 10>" {class: note}
browser -> frame: embeds {style.stroke: "#727169"}

liq -> state: file.write.stream(atomic=true) {style.stroke: "#98bb6c"}
zola -> nginx: "templates with\nSSI comments" {style.stroke: "#727169"}
state -> nginx: read on every request {style.stroke: "#98bb6c"}
nginx -> browser: once {style.stroke: "#727169"}
nginx -> frame: "assembled HTML\nfragment, every 10 s" {style.stroke: "#98bb6c"}
