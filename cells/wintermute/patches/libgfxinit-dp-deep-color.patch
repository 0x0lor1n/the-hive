diff --git a/3rdparty/libgfxinit/common/hw-gfx-edid.adb b/3rdparty/libgfxinit/common/hw-gfx-edid.adb
index 40bd630..c04a417 100644
--- a/3rdparty/libgfxinit/common/hw-gfx-edid.adb
+++ b/3rdparty/libgfxinit/common/hw-gfx-edid.adb
@@ -173,4 +173,63 @@ package body HW.GFX.EDID is
       return Mode;
    end Preferred_Mode;
 
+   ----------------------------------------------------------------------------
+
+   CEA_EXT_TAG                         : constant :=     16#02#;
+   CEA_EXT_REVISION                    : constant :=          1;
+   CEA_EXT_DTD_OFFSET                  : constant :=          2;
+   CEA_EXT_DATA_BLOCKS                 : constant :=          4;
+
+   CEA_DB_TAG_SHIFT                    : constant :=          5;
+   CEA_DB_LENGTH_MASK                  : constant :=     16#1f#;
+   CEA_DB_TAG_VENDOR_SPECIFIC          : constant :=          3;
+
+   HDMI_VSDB_DC                        : constant :=          6;
+   HDMI_VSDB_DC_48                     : constant := 1 * 2 ** 6;
+   HDMI_VSDB_DC_36                     : constant := 1 * 2 ** 5;
+   HDMI_VSDB_DC_30                     : constant := 1 * 2 ** 4;
+
+   function Deep_Color_BPC (Raw_Ext : Raw_EDID_Data) return BPC_Type
+   is
+      Data_End : Raw_EDID_Index;
+      Pos      : Raw_EDID_Index := CEA_EXT_DATA_BLOCKS;
+      Tag      : Byte;
+      Length   : Natural;
+      DC       : Byte;
+   begin
+      if Raw_Ext (0) /= CEA_EXT_TAG or else
+         Raw_Ext (CEA_EXT_REVISION) < 3 or else
+         not Checksum_Valid (Raw_Ext)
+      then
+         return Auto_BPC;
+      end if;
+
+      -- Data blocks end where the detailed timing descriptors start.
+      Data_End := Natural'Min
+        (Natural (Raw_Ext (CEA_EXT_DTD_OFFSET)), Raw_EDID_Index'Last);
+
+      while Pos < Data_End loop
+         Tag    := Shift_Right (Raw_Ext (Pos), CEA_DB_TAG_SHIFT);
+         Length := Natural (Raw_Ext (Pos) and CEA_DB_LENGTH_MASK);
+         exit when Pos + Length >= Data_End;
+
+         if (Tag = CEA_DB_TAG_VENDOR_SPECIFIC and Length >= HDMI_VSDB_DC) and then
+            -- HDMI IEEE OUI 00-0c-03, LSB first
+            (Raw_Ext (Pos + 1) = 16#03# and
+             Raw_Ext (Pos + 2) = 16#0c# and
+             Raw_Ext (Pos + 3) = 16#00#)
+         then
+            DC := Raw_Ext (Pos + HDMI_VSDB_DC);
+            return
+              (if    (DC and (HDMI_VSDB_DC_48 or HDMI_VSDB_DC_36)) /= 0 then 12
+               elsif (DC and HDMI_VSDB_DC_30) /= 0 then 10
+               else Auto_BPC);
+         end if;
+
+         Pos := Pos + Length + 1;
+      end loop;
+
+      return Auto_BPC;
+   end Deep_Color_BPC;
+
 end HW.GFX.EDID;
