+     (Raw_EDID (EXTENSIONS) /= 0)
+   with
+      Pre => Valid (Raw_EDID);
+
+   -- Deepest RGB depth of the HDMI VSDB in a CEA-861 extension block, capped at
+   -- 12, or Auto_BPC. Linux takes it when the base block gives no depth.
+   function Deep_Color_BPC (Raw_Ext : Raw_EDID_Data) return BPC_Type;
+
 end HW.GFX.EDID;
