CONFIG_VENDOR_DELL=y
CONFIG_BOARD_DELL_PRECISION_3520=y
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_BOOTSPLASH_FILE=""
CONFIG_VGA_BIOS=y
CONFIG_MAINBOARD_USE_LIBGFXINIT=y
CONFIG_CONSOLE_CBMEM=y
CONFIG_CONSOLE_SPI_FLASH=y
CONFIG_DRIVERS_PS2_KEYBOARD=y
# CONFIG_EDK2_SECURE_BOOT_SUPPORT is not set
CONFIG_EDK2_DISABLE_TPM=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="--pcd gEfiMdeModulePkgTokenSpaceGuid.PcdPs2KbdExtendedVerification=FALSE"
# CONFIG_EDK2_USE_LVGL_RENDERER is not set
CONFIG_USE_CBFS_FILE_OPTION_BACKEND=y
CONFIG_INTEL_OC_MAILBOX_ENABLE_UNDERVOLTING=y
CONFIG_PCIEXP_HOTPLUG=y
CONFIG_PCIEXP_HOTPLUG_BUSES=32
CONFIG_PCIEXP_HOTPLUG_MEM=0x8000000
