{
  inputs,
  cell,
  ...
}: let
  inherit (inputs) pkgs;
  llmAgents = inputs.llm-agents.packages.${pkgs.stdenv.hostPlatform.system};

  # nixq goes in front of PATH inside the agent process, so only the shells
  # the agent spawns get it; human shells keep the real client.
  withNixq = pkg:
    pkgs.symlinkJoin {
      name = "${pkg.name}-nixq";
      paths = [pkg];
      nativeBuildInputs = [pkgs.makeWrapper];
      postBuild = ''
        for f in ${pkg}/bin/*; do
          rm "$out/bin/''${f##*/}"
          makeWrapper "$f" "$out/bin/''${f##*/}" --prefix PATH : ${nixq}/bin
        done
      '';
      inherit (pkg) meta;
    };

  # PATH shim named "nix" for agent shells: collapses copying/building progress
  # on stderr to one summary line. From the first "error" line onward
  # everything is verbatim; warnings/traces always pass. TTY or NIXQ=off →
  # exec the real nix untouched. See cells/repo/nixq/main_test.go.
  nixq = pkgs.buildGoModule {
    pname = "nixq";
    version = "0.1.0";
    src = ./nixq;
    vendorHash = null;
    # Shipped as `nix` so it shadows the client without touching call sites.
    postInstall = "mv $out/bin/nixq $out/bin/nix";
    meta.mainProgram = "nix";
  };
in {
  agenix = inputs.agenix-rekey.packages.${pkgs.stdenv.hostPlatform.system}.default;

  # Re-exported from this cell's own llm-agents input (cells/repo/flake.nix),
  # so the workstation cell installs the SAME pin the devshell runs, without
  # declaring llm-agents a second time.
  # The patch routes six prompt_toolkit classes (session-title badge, yolo,
  # clarify answer, voice) through the skin; upstream hardcodes them in
  # cli_tui_mixin.py's base style. Drop it once upstream _STYLE_TEMPLATES has
  # them.
  # extended-enter: hermes only requests kitty-protocol Shift+Enter under
  # terminals it knows (tmux, kitty, ghostty...); inside herdr TERM is the
  # outer xterm-256color, so Shift+Enter fell through to submit. Keys on
  # HERDR_ENV=1. Drop once upstream `_terminal_supports_extended_enter_keys`
  # checks it.
  # anthropic-timeout-type: upstream pins anthropic==0.87.0 (stock httpx) but
  # llm-agents builds against nixpkgs anthropic 1.x (vendored httpx2); the
  # httpx.Timeout hermes passes fails the SDK's isinstance and ends up as the
  # socket connect timeout -> TypeError before any request leaves. Drop once
  # upstream moves to anthropic 1.x or llm-agents pins 0.x.
  hermes-agent = withNixq (llmAgents.hermes-agent.overrideAttrs (old: {
    patches =
      (old.patches or [])
      ++ [
        ./hermes-skin-pt-classes.patch
        ./hermes-herdr-extended-enter.patch
        ./hermes-anthropic-timeout-type.patch
      ];
  }));
  # The two per-tty agents + opencode's plugin bundle, installed into both
  # homes by workstation/home/dev/agents.nix.
  claude-code = withNixq llmAgents.claude-code;
  opencode = withNixq llmAgents.opencode;
  inherit (llmAgents) oh-my-opencode;

  # Anthropic loopback proxy that images the bulky, hash-free parts of each
  # request (system prompt, tool docs, cold history). Lossy: hashes read back
  # from imaged history are a confabulation risk; fresh tool output stays text.
  pxpipe = pkgs.buildGoModule {
    pname = "pxpipe";
    version = "0.4.20";
    src = ./pxpipe;
    vendorHash = "sha256-VTQVkyg5NMgWv/Ia0QOt72CBYq31b1a7Gn+NyormWPk=";
    # The library is a vendored Go module, not our src, so `patches` cannot
    # reach it: patch the vendor tree once configurePhase has copied it in
    # (read-only, hence the chmod). vendorHash is unaffected.
    postConfigure = ''
      chmod -R u+w vendor/github.com/evan-choi/pxpipe-go
      patch -p1 -d vendor/github.com/evan-choi/pxpipe-go < ${./pxpipe-opening-task.patch}
    '';
    meta.mainProgram = "pxpipe";
  };

  inherit nixq;

  # Rust Token Killer: rewrites git/cargo/ls/... to compact output before it
  # reaches the model. Drops noise, keeps signal; pinned tag, CLI filters only —
  # telemetry is disabled in the devshell via RTK_TELEMETRY_DISABLED=1.
  rtk = pkgs.rustPlatform.buildRustPackage rec {
    pname = "rtk";
    version = "0.47.0";
    src = pkgs.fetchFromGitHub {
      owner = "rtk-ai";
      repo = "rtk";
      tag = "v${version}";
      hash = "sha256-qYVkFLS6G4Tf1NmD9B3kJkyb47XREoVE65EqBtbzzjs=";
    };
    cargoHash = "sha256-2lwLPia3v7xagKsrCpayixZMmOqX15qrjsVP8/RQCXE=";
    # Upstream tests touch $HOME / network; smoke-checked in the devshell instead.
    doCheck = false;
    meta.mainProgram = "rtk";
  };

  # The hermes plugin rtk ships, generated by the pinned rtk itself so the
  # adapter and the `rtk rewrite` exit-code contract cannot drift. Pure:
  # `rtk init` only writes under $HOME.
  rtk-hermes-plugin =
    pkgs.runCommand "rtk-hermes-plugin" {
      env.RTK_TELEMETRY_DISABLED = "1";
    } ''
      export HOME="$TMPDIR/home"
      mkdir -p "$HOME"
      ${pkgs.lib.getExe cell.packages.rtk} init -g --agent hermes >/dev/null
      cp -r "$HOME/.hermes/plugins/rtk-rewrite" "$out"
    '';

  # Commit-message rules every commit on the box has to meet, human or agent
  # (skill code-comments-for-seniors, "Fix commits"). Lints a message file:
  # one line per violation, exit 1 on any.
  commit-msg-lint = pkgs.writeShellApplication {
    name = "commit-msg-lint";
    text = ''
      f="''${1:?message file}"
      fail=0
      say() { echo "commit-msg: $*" >&2; fail=1; }
      # Drop comment lines and the scissors block git appends on -v.
      msg=$(sed -e '/^# ------------------------ >8 ------------------------$/,$d' -e '/^#/d' "$f")
      subject=$(printf '%s\n' "$msg" | sed -n '1p')
      [ -n "$subject" ] || { say "empty subject"; exit 1; }
      # Conventional-commit shape with repo-local types: `<type>(<scope>)!?: <what>`
      # or the hive's `<cell>/<area>: <what>`. Lower-case first word, no trailing period.
      printf '%s' "$subject" | grep -Eq '^[a-z][a-z0-9/_.-]*(\([^)]+\))?!?: [^ ]' \
        || say "subject is not '<type>(<scope>): <what>' -- got: $subject"
      printf '%s' "$subject" | grep -Eq '\.$' && say "subject ends with a period"
      [ "''${#subject}" -le 72 ] || say "subject is ''${#subject} chars (max 72)"
      line2=$(printf '%s\n' "$msg" | sed -n '2p')
      [ -z "$line2" ] || say "second line must be blank"
      # The agent is the author, not a co-author.
      printf '%s\n' "$msg" | grep -Eqi '^(co-authored-by|generated-by|signed-off-by: .*(claude|hermes|anthropic))' \
        && say "drop the Co-authored-by / Generated-by trailer"
      printf '%s\n' "$msg" | grep -Eqi 'noreply@anthropic\.com|🤖' \
        && say "agent attribution in the message"
      # Narration instead of facts.
      printf '%s' "$subject" | grep -Eqi '^(feat|fix|chore|refactor|docs|wip)?(\([^)]*\))?:? *(update|updates|changes|misc|various|stuff|fixes|tweaks|improvements)( |$)' \
        && say "subject names nothing ('$subject')"
      printf '%s\n' "$msg" | grep -Eqi '^(this (commit|change)|in this (commit|pr)|i (have|added|changed))' \
        && say "body narrates ('this commit…'/'I added…'); state the fact and the why"
      exit "$fail"
    '';
  };

  # Global git hooks: core.hooksPath for the dev account points here
  # (workstation/home/dev/default.nix). Two layers per hook, in order:
  #
  #   1. the box-wide rule set in this derivation's lefthook.yaml;
  #   2. the project's own hooks, untouched -- `<git-dir>/hooks/<name>` when the
  #      repo installs them itself (devtools-lib symlinks, husky, anything), else
  #      `lefthook run <name>` against the repo's lefthook.yml, so a project only
  #      has to ship its config and never call `lefthook install`.
  #
  # Git honours hooksPath over <git-dir>/hooks, so the hook file a project
  # writes there is reachable only through this dispatcher. lefthook refuses to
  # sync hooks while hooksPath is set; --no-auto-install keeps `run` from
  # trying. LEFTHOOK=0 skips both layers, as it does with lefthook alone.
  git-hooks = let
    inherit (pkgs) lib;
    globalConfig = (pkgs.formats.yaml {}).generate "global-lefthook.yaml" {
      commit-msg.jobs = [
        {
          name = "commit-msg-lint";
          run = "${lib.getExe cell.packages.commit-msg-lint} {1}";
        }
      ];
    };
    hookNames = [
      "applypatch-msg"
      "pre-applypatch"
      "post-applypatch"
      "pre-commit"
      "pre-merge-commit"
      "prepare-commit-msg"
      "commit-msg"
      "post-commit"
      "pre-rebase"
      "post-checkout"
      "post-merge"
      "pre-push"
      "post-rewrite"
      "pre-auto-gc"
    ];
    dispatch = pkgs.writeShellScript "git-hook-dispatch" ''
      [ "''${LEFTHOOK:-}" = "0" ] && exit 0
      hook=$(basename "$0")
      lefthook=${lib.getExe pkgs.lefthook}

      # Layer 1: the box-wide rules. Failures only, the git output is enough.
      LEFTHOOK_CONFIG=${globalConfig} LEFTHOOK_OUTPUT=failure \
        "$lefthook" run --no-auto-install "$hook" "$@" || exit 1

      # Layer 2: the project's. A hook of its own wins over its lefthook.yml.
      # `rev-parse --git-path hooks` answers with hooksPath while it is set,
      # i.e. this very file: resolve the real directory instead.
      local_hook="$(git rev-parse --absolute-git-dir)/hooks/$hook"
      if [ -x "$local_hook" ]; then
        exec "$local_hook" "$@"
      fi
      top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
      for f in lefthook.yml lefthook.yaml .lefthook.yml .lefthook.yaml; do
        if [ -f "$top/$f" ]; then
          exec "$lefthook" run --no-auto-install "$hook" "$@"
        fi
      done
      exit 0
    '';
  in
    pkgs.runCommand "git-hooks" {} ''
      mkdir -p $out
      for h in ${lib.escapeShellArgs hookNames}; do
        ln -s ${dispatch} "$out/$h"
      done
    '';
}
