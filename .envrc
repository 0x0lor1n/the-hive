# rensa direnv, pinned by content hash. `use ren //cell/block/target` resolves
# the raw rensa output tree and watches only that cell.
source "$(fetchurl \
  https://gitlab.com/rensa-nix/direnv/-/raw/v0.3.0/direnvrc \
  sha256-u7+KEz684NnIZ+Vh5x5qLrt8rKdnUNexewBoeTcEVHQ=)"

# rensa invalidates its profile cache only on watched files (flake.*, the
# devshell block); the shell's packages come from cells/repo/packages.nix
# and its patches, so a patched hermes never reached the shell PATH
# (2026-09-26: Shift+Enter fell through to submit for a day).
watch_file cells/repo/packages.nix cells/repo/*.patch

# `dev <cell>` writes .ren/devshell; default is the deploy shell.
cell="$(read_state devshell)"
cell="${cell:-repo}"
if [ "$cell" = "repo" ]; then
  use ren //repo/devshells/default
else
  use ren //"$cell"/devshells/"$cell"
fi
