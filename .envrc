# rensa's direnv integration, pinned by content hash.
#
# `use ren //<cell>/<block>/<target>` resolves to the RAW rensa output tree --
# `.#x86_64-linux.repo.devshells.default` -- not to the flake's `devShells`
# passthrough. That is the point: it also watches only THIS cell's files
# (cells/repo/{devshells.nix,flake.nix,flake.lock}), so editing cells/server or
# cells/hisilome does not invalidate the shell, and neither does a rebuild of a
# host. With the root flake.nix/flake.lock, that is the whole watch set.
#
# The hash is direnv's own integrity check, verified against the v0.3.0 tag of
# gitlab.com/rensa-nix/direnv before pinning. Bumping the version means
# re-running `direnv fetchurl <url>` and replacing both the tag and the hash.
source "$(fetchurl \
  https://gitlab.com/rensa-nix/direnv/-/raw/v0.3.0/direnvrc \
  sha256-u7+KEz684NnIZ+Vh5x5qLrt8rKdnUNexewBoeTcEVHQ=)"

use ren //repo/devshells/default
